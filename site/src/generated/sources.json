{
 "canonical": {
  "pr": {
   "name": "pr",
   "long_name": "Precipitation",
   "units": "mm day-1",
   "standard_name": "lwe_precipitation_rate",
   "cell_methods": "time: sum",
   "colormap": "precip",
   "diff_colormap": "BrBG",
   "comparable_note": ""
  },
  "tas": {
   "name": "tas",
   "long_name": "Mean 2 m air temperature",
   "units": "degC",
   "standard_name": "air_temperature",
   "cell_methods": "time: mean",
   "colormap": "thermal",
   "diff_colormap": "RdBu_r",
   "comparable_note": "PRISM tmean is (tmin+tmax)/2, not a 24-hour mean."
  },
  "tasmax": {
   "name": "tasmax",
   "long_name": "Maximum 2 m air temperature",
   "units": "degC",
   "standard_name": "air_temperature",
   "cell_methods": "time: maximum",
   "colormap": "thermal",
   "diff_colormap": "RdBu_r",
   "comparable_note": "Reanalysis maxima use hourly values; station-based products use instantaneous extremes."
  },
  "tasmin": {
   "name": "tasmin",
   "long_name": "Minimum 2 m air temperature",
   "units": "degC",
   "standard_name": "air_temperature",
   "cell_methods": "time: minimum",
   "colormap": "thermal",
   "diff_colormap": "RdBu_r",
   "comparable_note": "Reanalysis minima use hourly values; station-based products use instantaneous extremes."
  },
  "tdps": {
   "name": "tdps",
   "long_name": "Mean 2 m dew point temperature",
   "units": "degC",
   "standard_name": "dew_point_temperature",
   "cell_methods": "time: mean",
   "colormap": "haline",
   "diff_colormap": "RdBu_r",
   "comparable_note": ""
  },
  "ps": {
   "name": "ps",
   "long_name": "Mean surface pressure",
   "units": "hPa",
   "standard_name": "surface_air_pressure",
   "cell_methods": "time: mean",
   "colormap": "dense",
   "diff_colormap": "RdBu_r",
   "comparable_note": ""
  },
  "rsds": {
   "name": "rsds",
   "long_name": "Surface downwelling shortwave radiation",
   "units": "MJ m-2 day-1",
   "standard_name": "surface_downwelling_shortwave_flux_in_air",
   "cell_methods": "time: sum",
   "colormap": "solar",
   "diff_colormap": "RdBu_r",
   "comparable_note": ""
  },
  "sfcWind": {
   "name": "sfcWind",
   "long_name": "Mean 10 m wind speed",
   "units": "m s-1",
   "standard_name": "wind_speed",
   "cell_methods": "time: mean",
   "colormap": "speed",
   "diff_colormap": "RdBu_r",
   "comparable_note": "MERRA-2 (POWER) reports 2 m and 10 m wind; ERA5 uses hourly 10 m speed."
  },
  "sm1": {
   "name": "sm1",
   "long_name": "Surface-layer soil moisture",
   "units": "m3 m-3",
   "standard_name": "volume_fraction_of_condensed_water_in_soil",
   "cell_methods": "time: mean",
   "colormap": "rain",
   "diff_colormap": "BrBG",
   "comparable_note": "ERA5/ERA5-Land layer 1 is 0-7 cm; MERRA-2 GWETTOP is a 0-1 wetness fraction, not volumetric."
  },
  "sm2": {
   "name": "sm2",
   "long_name": "Second-layer soil moisture",
   "units": "m3 m-3",
   "standard_name": "volume_fraction_of_condensed_water_in_soil",
   "cell_methods": "time: mean",
   "colormap": "rain",
   "diff_colormap": "BrBG",
   "comparable_note": "ERA5/ERA5-Land layer 2 is 7-28 cm."
  }
 },
